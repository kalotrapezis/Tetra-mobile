<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.MANAGE_MEDIA" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Calendar reminders on time: a calendar app's own exact alarms (Android 13+), the asked-for kind before -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!-- Maps: where you are, and directions (only while the map is open) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" /> <!-- place reminders, off until the user turns them on -->
    <!-- Maps on the car's screen (Android Auto): directions, and the map drawn on its surface -->
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Data: how much each app used (the user turns on Usage access in Android's settings; Plan.md § Data) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- Data names the apps by their icons in the launcher; not QUERY_ALL_PACKAGES (Play restricts it) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Settings › Αλληλογραφία names the email app that opens mailto: links now -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>
    <application android:allowBackup="false" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:largeHeap="true" android:label="@string/app_name" android:supportsRtl="true" android:theme="@style/Theme.LocalDrive">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/local_drive_paths" />
        </provider>
        <receiver android:name=".DriveOpenerReceiver" android:exported="false" />
        <!-- Tetra Maps in Android Auto (MapsCar.kt); a navigation app not from Play shows there with Android Auto's Unknown sources on -->
        <service android:name=".MapsCarService" android:exported="true" android:label="@string/home_label_maps" android:icon="@mipmap/applet_maps">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>
        <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/automotive_app_desc" />
        <meta-data android:name="androidx.car.app.minCarApiLevel" android:value="1" />
        <!-- Contacts › Show in the phone's contacts: the account and its (one-way) contacts copy (ContactsAccount.kt) -->
        <service android:name=".ContactsAuthService" android:exported="true">
            <intent-filter><action android:name="android.accounts.AccountAuthenticator" /></intent-filter>
            <meta-data android:name="android.accounts.AccountAuthenticator" android:resource="@xml/contacts_authenticator" />
        </service>
        <service android:name=".ContactsSyncService" android:exported="true">
            <intent-filter><action android:name="android.content.SyncAdapter" /></intent-filter>
            <meta-data android:name="android.content.SyncAdapter" android:resource="@xml/contacts_syncadapter" />
            <meta-data android:name="android.provider.CONTACTS_STRUCTURE" android:resource="@xml/contacts_structure" />
        </service>
        <!-- Phone (Plan.md § Phone): Tetra as the phone's Phone app — the call screen Telecom binds while Tetra holds ROLE_DIALER,
             the keypad Android opens for a number, and the notification's Decline / Hang up -->
        <service android:name=".PhoneInCallService" android:permission="android.permission.BIND_INCALL_SERVICE" android:exported="true">
            <meta-data android:name="android.telecom.IN_CALL_SERVICE_UI" android:value="true" />
            <intent-filter><action android:name="android.telecom.InCallService" /></intent-filter>
        </service>
        <activity android:name=".PhoneCallActivity" android:exported="false" android:launchMode="singleTask" android:taskAffinity="com.kalotrapezis.drive.call"
            android:excludeFromRecents="true" android:showWhenLocked="true" android:turnScreenOn="true" />
        <activity android:name=".PhoneActivity" android:exported="true" android:label="@string/home_label_phone" android:taskAffinity="com.kalotrapezis.drive.dial" android:windowSoftInputMode="stateAlwaysHidden">
            <intent-filter><action android:name="android.intent.action.DIAL" /><category android:name="android.intent.category.DEFAULT" /></intent-filter>
            <intent-filter><action android:name="android.intent.action.DIAL" /><category android:name="android.intent.category.DEFAULT" /><data android:scheme="tel" /></intent-filter>
            <intent-filter><action android:name="android.intent.action.VIEW" /><category android:name="android.intent.category.DEFAULT" /><category android:name="android.intent.category.BROWSABLE" /><data android:scheme="tel" /></intent-filter>
            <!-- the call log: what Android opens from a missed-call notification -->
            <intent-filter><action android:name="android.intent.action.VIEW" /><category android:name="android.intent.category.DEFAULT" /><data android:mimeType="vnd.android.cursor.dir/calls" /></intent-filter>
        </activity>
        <activity android:name=".BriefActivity" android:exported="false" android:label="@string/assistant_briefs_channel" />
        <activity android:name=".DataActivity" android:exported="false" android:label="@string/home_label_data" android:taskAffinity="com.kalotrapezis.drive.data" />
        <receiver android:name=".PhoneCallReceiver" android:exported="false" />
        <receiver android:name=".PhoneRelayReceiver" android:exported="false" />
        <!-- Android's missed-call notice, handed to the phone app; only Telecom (it holds MODIFY_PHONE_STATE) may send it -->
        <receiver android:name=".PhoneMissedReceiver" android:exported="true" android:permission="android.permission.MODIFY_PHONE_STATE">
            <intent-filter><action android:name="android.telecom.action.SHOW_MISSED_CALLS_NOTIFICATION" /></intent-filter>
        </receiver>
        <service android:name=".PhoneScreening" android:permission="android.permission.BIND_SCREENING_SERVICE" android:exported="true">
            <intent-filter><action android:name="android.telecom.CallScreeningService" /></intent-filter>
        </service>
        <service android:name=".SyncJob" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="false" />
        <service android:name=".SyncService" android:exported="false" android:foregroundServiceType="dataSync" />
        <service android:name=".PhotoAnalysisService" android:exported="false" android:foregroundServiceType="dataSync" />
        <!-- An alarm ringing: its time, Snooze and Dismiss, over the lock screen -->
        <activity android:name=".AlarmRingActivity" android:exported="false" android:launchMode="singleTask" android:taskAffinity="com.kalotrapezis.drive.alarm"
            android:excludeFromRecents="true" android:showWhenLocked="true" android:turnScreenOn="true" />
        <!-- The Timer while one runs: its countdown notification, the alarm at the end, the 30 s look at the other devices -->
        <service android:name=".TimerService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Countdown timer, alarm or stopwatch the user started, kept in step with their other devices" />
        </service>
        <!-- Stand mode: a dim clock on black while charging, chosen as Android's screen saver -->
        <service android:name=".StandDream" android:exported="true" android:label="@string/stand_mode" android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
        <!-- Data's live speed in the status bar, while the user has it on (Plan.md § Data) -->
        <service android:name=".DataSpeedService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Shows the network speed in the status bar, which the user switched on" />
        </service>
        <!-- Listening for the paired computer with the app closed: its syncs, and desktop Maps asking where the phone is -->
        <service android:name=".SyncListenService" android:exported="false" android:foregroundServiceType="specialUse|location">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Answers the user's own paired computer on the local network: sync requests and the phone's location for its Maps" />
        </service>
        <activity android:name=".MainActivity" android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Offered as the device's gallery app. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.APP_GALLERY" />
            </intent-filter>
            <!-- Opens photos and videos from other apps and the camera's "review last shot". -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.provider.action.REVIEW" />
                <action android:name="com.android.camera.action.REVIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>
        <!-- Settings › App icons (asked 17 Oct): a launcher icon for each part of Tetra, off until switched on; AppletLaunch
             hands the part to MainActivity (its own empty task affinity, so a running Tetra is asked, not just brought up). -->
        <activity android:name=".AppletLaunch" android:exported="false" android:theme="@android:style/Theme.NoDisplay"
            android:taskAffinity="" android:excludeFromRecents="true" android:noHistory="true" />
        <activity-alias android:name=".AppPhotos" android:targetActivity=".AppletLaunch" android:enabled="false" android:exported="true" android:label="@string/home_label_photos" android:icon="@mipmap/applet_photos" android:roundIcon="@mipmap/applet_photos">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".AppFiles" android:targetActivity=".AppletLaunch" android:enabled="false" android:exported="true" android:label="@string/home_label_files" android:icon="@mipmap/applet_files" android:roundIcon="@mipmap/applet_files">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".AppNotes" android:targetActivity=".AppletLaunch" android:enabled="false" android:exported="true" android:label="@string/home_label_notes" android:icon="@mipmap/applet_notes" android:roundIcon="@mipmap/applet_notes">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".AppScanner" android:targetActivity=".AppletLaunch" android:enabled="false" android:exported="true" android:label="@string/home_label_scanner" android:icon="@mipmap/applet_scanner" android:roundIcon="@mipmap/applet_scanner">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".AppCodes" android:targetActivity=".AppletLaunch" android:enabled="false" android:exported="true" android:label="@string/home_label_codes" android:icon="@mipmap/applet_codes" android:roundIcon="@mipmap/applet_codes">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".AppOffice" android:targetActivity=".AppletLaunch" android:enabled="false" android:exported="true" android:label="@string/home_label_office" android:icon="@mipmap/applet_office" android:roundIcon="@mipmap/applet_office">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".AppTextEditor" android:targetActivity=".AppletLaunch" android:enabled="false" android:exported="true" android:label="@string/home_label_text" android:icon="@mipmap/applet_text_editor" android:roundIcon="@mipmap/applet_text_editor">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".AppCalendar" android:targetActivity=".AppletLaunch" android:enabled="false" android:exported="true" android:label="@string/home_label_calendar" android:icon="@mipmap/applet_calendar" android:roundIcon="@mipmap/applet_calendar">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".AppTimer" android:targetActivity=".AppletLaunch" android:enabled="false" android:exported="true" android:label="@string/home_label_timer" android:icon="@mipmap/applet_timer" android:roundIcon="@mipmap/applet_timer">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".AppMaps" android:targetActivity=".AppletLaunch" android:enabled="false" android:exported="true" android:label="@string/home_label_maps" android:icon="@mipmap/applet_maps" android:roundIcon="@mipmap/applet_maps">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".AppMail" android:targetActivity=".AppletLaunch" android:enabled="false" android:exported="true" android:label="@string/home_label_mail" android:icon="@mipmap/applet_mail" android:roundIcon="@mipmap/applet_mail">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".AppContacts" android:targetActivity=".AppletLaunch" android:enabled="false" android:exported="true" android:label="@string/home_label_contacts" android:icon="@mipmap/applet_contacts" android:roundIcon="@mipmap/applet_contacts">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".AppPhone" android:targetActivity=".PhoneActivity" android:enabled="false" android:exported="true" android:label="@string/home_label_phone" android:icon="@mipmap/applet_phone" android:roundIcon="@mipmap/applet_phone">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".AppData" android:targetActivity=".DataActivity" android:enabled="false" android:exported="true" android:label="@string/home_label_data" android:icon="@mipmap/applet_data" android:roundIcon="@mipmap/applet_data">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".AppAssistant" android:targetActivity=".AssistantSheetActivity" android:enabled="false" android:exported="true" android:label="@string/home_label_assistant" android:icon="@mipmap/applet_assistant" android:roundIcon="@mipmap/applet_assistant">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <!-- Tetra Assistant (Assistant.kt): the chat, and the sheet the phone's assistant gesture opens over any app -->
        <activity android:name=".AssistantActivity" android:exported="false" android:label="@string/app_assistant" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".AssistantSheetActivity" android:exported="true" android:label="@string/home_label_assistant" android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true" android:launchMode="singleTask" android:taskAffinity="com.kalotrapezis.drive.assistant" android:windowSoftInputMode="adjustResize">
            <intent-filter><action android:name="android.intent.action.ASSIST" /><category android:name="android.intent.category.DEFAULT" /></intent-filter>
        </activity>
        <service android:name=".AssistantService" android:exported="true" android:label="@string/home_label_assistant" android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data android:name="android.voice_interaction" android:resource="@xml/assistant_interaction" />
            <intent-filter><action android:name="android.service.voice.VoiceInteractionService" /></intent-filter>
        </service>
        <service android:name=".AssistantSessionService" android:exported="true" android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <service android:name=".AssistantRecognition" android:exported="true" android:label="@string/home_label_assistant">
            <intent-filter><action android:name="android.speech.RecognitionService" /></intent-filter>
        </service>
        <!-- Calendar: an .ics from any app (Open with › Tetra Calendar) is imported -->
        <activity-alias android:name=".CalendarOpen" android:targetActivity=".MainActivity" android:exported="true" android:label="@string/home_label_calendar" android:icon="@mipmap/applet_calendar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/calendar" />
                <data android:mimeType="text/x-vcalendar" />
                <data android:mimeType="application/ics" />
            </intent-filter>
        </activity-alias>
        <!-- Office: "Open with › Tetra Office" for documents, spreadsheets, presentations and PDFs (17 Oct) from any app (asked 16 Oct);
             Android's Always makes it the default. -->
        <activity-alias android:name=".OfficeOpen" android:targetActivity=".MainActivity" android:exported="true" android:label="@string/home_label_office" android:icon="@drawable/ic_office">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="text/rtf" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.slideshow" />
                <data android:mimeType="application/vnd.oasis.opendocument.presentation" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity-alias>
        <!-- Office › Text editor: "Open with Tetra" for text files from any app (asked 2026-09-27). -->
        <activity android:name=".TextEditorActivity" android:exported="true" android:label="@string/home_label_text_editor" android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
            </intent-filter>
        </activity>
        <!-- Tetra as the email app (31 Oct): mailto: links, and «Email (Tetra)» in the share menu, open Mail's compose page
             (MainActivity.mailWrite). An alias, so the share menu shows its own name beside «Send to computer». -->
        <activity-alias android:name=".MailShare" android:targetActivity=".MainActivity" android:exported="true"
            android:label="@string/mail_share" android:icon="@mipmap/applet_mail" android:roundIcon="@mipmap/applet_mail">
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mailto" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity-alias>
        <!-- Send to computer: Tetra in the share menu; shared files go to the paired computer (SendToComputer.kt) -->
        <activity android:name=".SendToComputer" android:exported="true" android:label="@string/home_label_send"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <receiver android:name=".LocationReminderReceiver" android:exported="false" />
        <receiver android:name=".CalendarAlarmReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".SyncActionReceiver" android:exported="false">
            <intent-filter>
                <action android:name="com.kalotrapezis.drive.PAUSE" />
                <action android:name="com.kalotrapezis.drive.ANALYSIS_PAUSE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
