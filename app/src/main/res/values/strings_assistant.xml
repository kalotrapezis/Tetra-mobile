    <string name="assistant_pause_value">%1$s s</string>
    <string name="assistant_default_make">Make AI Assist your assistant</string>
    <string name="assistant_default_hint">On the page that opens, tap Digital assistant app (or Default assistant) and choose Tetra. Then holding the power button opens AI Assist.</string>
    <string name="assistant_default_xiaomi">On Xiaomi also: Settings › Additional settings › Gesture shortcuts › Press and hold the power button › Assistant.</string>
    <string name="assistant_relations_note">Who people are to you, so you can say “call my sister”. They are saved on your own card in Contacts (Related people), so Contacts and the computer show them too.</string>
