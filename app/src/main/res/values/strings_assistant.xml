    <string name="assistant_words">My words</string>
    <string name="assistant_words_note">Names and words the transcription should spell right, separated by commas. They are sent to Mistral with each recording.</string>
    <string name="assistant_contact_words">Add my favourite contacts\' names</string>
    <string name="assistant_contact_words_note">Up to 50 favourites, so that \"call …\" gets the name right. These names are then sent to Mistral with each recording.</string>
