    <string name="assistant_key_saved">Saved on this phone</string>
    <string name="assistant_key_missing">Not set yet</string>
    <string name="assistant_key_note">Make one at console.mistral.ai › API Keys. It is kept encrypted on this phone. What you say, your questions and the tools\' short answers (names, titles) go to Mistral; your files stay here.</string>
    <string name="assistant_default">Default assistant</string>
    <string name="assistant_default_yes">Tetra</string>
    <string name="assistant_default_no">Another app</string>
    <string name="assistant_choose">Choose</string>
    <string name="assistant_default_note">Choose Tetra as the digital assistant app. Then hold the power button, swipe up from a bottom corner or hold Home: Tetra listens at once and answers when you stop talking. If your phone keeps the power button for Google, turn on AI Assist in Appearance › App icons and use its icon.</string>
    <string name="assistant_open">Open the assistant</string>
