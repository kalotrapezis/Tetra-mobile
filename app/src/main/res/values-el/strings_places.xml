    <string name="place_reminders_location_on">Επιτρέπεται</string>
    <string name="place_reminders_location_off">Χρειάζεται: διάλεξε «Να επιτρέπεται πάντα»</string>
    <string name="place_reminders_none">Καμία υπενθύμιση τοποθεσίας ακόμη</string>
    <string name="place_reminders_any">Όποια λίστα έχει ακόμη κάτι</string>
    <string name="place_reminder_title">Η λίστα σου</string>
