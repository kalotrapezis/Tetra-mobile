    <string name="assistant_no_key">Najprv pridaj svoj kľúč API Mistral: Nastavenia › AI Assist.</string>
    <string name="assistant_words">Moje slová</string>
    <string name="assistant_words_note">Mená a slová, ktoré má prepis písať správne, oddelené čiarkami. Posielajú sa do Mistral s každou nahrávkou.</string>
    <string name="assistant_contact_words">Pridaj mená mojich obľúbených kontaktov</string>
    <string name="assistant_contact_words_note">Až 50 obľúbených, aby \"zavolaj …\" správne zachytilo meno. Tieto mená sa potom posielajú do Mistral s každou nahrávkou.</string>
