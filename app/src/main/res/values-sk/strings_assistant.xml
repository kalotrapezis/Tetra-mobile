    <string name="assistant_voice">Hlas</string>
    <string name="assistant_voice_note">Hlasy Mistral znejú prirodzene a stoja málo (€0.016 za 1 000 prečítaných znakov). Mistral nemá slovenský hlas, ale anglické dobre čítajú aj iné jazyky. Ťukni na hlas a vypočuj si ho.</string>
