    <string name="assistant_offline">Ingen internetanslutning.</string>
    <string name="assistant_bad_key">Mistral-nyckeln är fel. Kontrollera den i Inställningar › AI Assist.</string>
    <string name="assistant_busy">Mistral är upptagen, eller så har nyckeln slut på kredit. Försök igen om en minut.</string>
    <string name="assistant_server">Mistral svarade med ett fel (%1$d).</string>
    <string name="assistant_no_key">Lägg först till din API-nyckel för Mistral: Inställningar › AI Assist.</string>
    <string name="assistant_words">Mina ord</string>
    <string name="assistant_words_note">Namn och ord som transkriptionen ska stava rätt, åtskilda med kommatecken. De skickas till Mistral med varje inspelning.</string>
    <string name="assistant_contact_words">Lägg till namnen på mina favoritkontakter</string>
    <string name="assistant_contact_words_note">Upp till 50 favoriter, så att \"ring …\" får namnet rätt. Dessa namn skickas sedan till Mistral med varje inspelning.</string>
