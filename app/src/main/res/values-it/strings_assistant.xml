    <string name="assistant_key_hint">Incolla la chiave</string>
    <string name="assistant_key_saved">Salvata su questo telefono</string>
    <string name="assistant_key_missing">Non ancora impostata</string>
    <string name="assistant_key_note">Creane una su console.mistral.ai › API Keys. Viene conservata cifrata su questo telefono. Ciò che dici, le tue domande e le brevi risposte degli strumenti (nomi, titoli) vanno a Mistral; i tuoi file restano qui.</string>
    <string name="assistant_default">Assistente predefinito</string>
    <string name="assistant_default_yes">Tetra</string>
    <string name="assistant_default_no">Un\'altra app</string>
    <string name="assistant_choose">Scegli</string>
    <string name="assistant_default_note">Scegli Tetra come app di assistente digitale. Poi tieni premuto il tasto di accensione, scorri verso l\'alto da un angolo in basso o tieni premuto Home: Tetra ascolta subito e risponde quando smetti di parlare. Se il telefono riserva il tasto di accensione a Google, attiva AI Assist in Aspetto › Icone delle app e usa la sua icona.</string>
    <string name="assistant_open">Apri l\'assistente</string>
    <string name="assistant_offline">Nessuna connessione a internet.</string>
    <string name="assistant_bad_key">La chiave Mistral non è corretta. Controllala in Impostazioni › AI Assist.</string>
    <string name="assistant_busy">Mistral è occupato oppure la chiave non ha più credito. Riprova tra un minuto.</string>
    <string name="assistant_server">Mistral ha risposto con un errore (%1$d).</string>
    <string name="assistant_no_key">Aggiungi prima la tua chiave API di Mistral: Impostazioni › AI Assist.</string>
    <string name="assistant_words">Le mie parole</string>
    <string name="assistant_words_note">Nomi e parole che la trascrizione deve scrivere correttamente, separati da virgole. Vengono inviati a Mistral con ogni registrazione.</string>
    <string name="assistant_contact_words">Aggiungi i nomi dei miei contatti preferiti</string>
    <string name="assistant_contact_words_note">Fino a 50 preferiti, così che \"chiama …\" riconosca bene il nome. Questi nomi vengono poi inviati a Mistral con ogni registrazione.</string>
    <string name="assistant_live">Live</string>
    <string name="assistant_live_end">Termina live</string>
    <string name="assistant_live_connecting">Connessione…</string>
    <string name="assistant_live_silence">La conversazione live è terminata dopo 20 secondi di silenzio.</string>
    <string name="assistant_live_cap">La conversazione live è terminata dopo 5 minuti.</string>
    <string name="assistant_you">Tu</string>
    <string name="assistant_voice">Voce</string>
    <string name="assistant_voice_note">Le voci di Mistral suonano naturali e costano poco (€0.016 ogni 1.000 caratteri letti). Mistral ha voci italiane; quelle inglesi leggono bene anche altre lingue. Tocca una voce per ascoltarla.</string>
    <string name="assistant_voice_phone">La voce del telefono (gratis)</string>
    <string name="assistant_voice_first">La prima voce di Mistral</string>
    <string name="assistant_voice_sample">Ciao, ecco come suoneranno le mie risposte.</string>
    <string name="assistant_spent">Soldi spesi</string>
    <string name="assistant_spent_note">Tutti i costi di AI Assist ai prezzi di listino di Mistral, tutte le chat insieme. Azzera avvia un nuovo conteggio; il totale e i conteggi passati restano.</string>
    <string name="assistant_spent_since">Dal %1$s</string>
    <string name="assistant_spent_total">Totale dall\'inizio</string>
    <string name="assistant_spent_reset">Azzera</string>
    <string name="assistant_spent_reset_ask">Azzerare? La cronologia resta.</string>
    <string name="assistant_pause">Tempo di pausa</string>
