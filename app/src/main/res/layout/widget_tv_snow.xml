<?xml version="1.0" encoding="utf-8"?>
<!-- The home screen's TV while AI Assist talks on it: snow (TvTalkService). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <ViewFlipper android:layout_width="match_parent" android:layout_height="match_parent" android:autoStart="true" android:flipInterval="110">
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/tv_snow0" android:contentDescription="@null" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/tv_snow1" android:contentDescription="@null" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/tv_snow2" android:contentDescription="@null" />
    </ViewFlipper>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
        <FrameLayout android:id="@+id/tv_talk" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="78" android:contentDescription="@string/assistant_tap_to_talk" />
        <FrameLayout android:id="@+id/tv_power" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="22" android:contentDescription="@string/tv_widget_power" />
    </LinearLayout>
</FrameLayout>
