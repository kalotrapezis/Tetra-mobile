<?xml version="1.0" encoding="utf-8"?>
<!-- The TV switched on (8 Nov): the mascot walks in from the left and says hello; a few seconds later, widget_tv_on. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <ViewFlipper android:layout_width="match_parent" android:layout_height="match_parent" android:autoStart="true" android:flipInterval="260">
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/tv_enter0" android:contentDescription="@null" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/tv_enter1" android:contentDescription="@null" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/tv_enter2" android:contentDescription="@null" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/tv_enter3" android:contentDescription="@null" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/tv_idle" android:contentDescription="@null" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/tv_idle" android:contentDescription="@null" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/tv_idle" android:contentDescription="@null" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/tv_idle" android:contentDescription="@null" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/tv_idle" android:contentDescription="@null" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/tv_idle" android:contentDescription="@null" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/tv_idle" android:contentDescription="@null" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/tv_idle" android:contentDescription="@null" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/tv_idle" android:contentDescription="@null" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/tv_idle" android:contentDescription="@null" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/tv_idle" android:contentDescription="@null" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/tv_idle" android:contentDescription="@null" />
    </ViewFlipper>
    <TextView android:id="@+id/tv_hello" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="10dp" android:layout_marginEnd="28dp" android:background="@drawable/tv_bubble" android:paddingHorizontal="8dp" android:paddingVertical="3dp"
        android:fontFamily="monospace" android:textStyle="bold" android:textSize="12sp" android:textColor="#2A2420" android:maxLines="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
        <FrameLayout android:id="@+id/tv_talk" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="78" android:contentDescription="@string/assistant_tap_to_talk" />
        <FrameLayout android:id="@+id/tv_power" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="22" android:contentDescription="@string/tv_widget_power" />
    </LinearLayout>
</FrameLayout>
