    <string name="assistant_you">Toi</string>
    <string name="assistant_voice">Voix</string>
    <string name="assistant_voice_note">Les voix de Mistral sonnent naturel et coûtent peu (0,016 € pour 1 000 caractères lus). Mistral a des voix françaises ; les anglaises lisent bien d\'autres langues aussi. Touche une voix pour l\'écouter.</string>
