    <string name="assistant_key_missing">Pas encore définie</string>
    <string name="assistant_key_note">Crée-en une sur console.mistral.ai › API Keys. Elle est conservée chiffrée sur ce téléphone. Ce que tu dis, tes questions et les courtes réponses des outils (noms, titres) vont à Mistral ; tes fichiers restent ici.</string>
    <string name="assistant_default">Assistant par défaut</string>
    <string name="assistant_default_yes">Tetra</string>
    <string name="assistant_default_no">Autre appli</string>
    <string name="assistant_choose">Choisir</string>
    <string name="assistant_default_note">Choisis Tetra comme appli d\'assistant numérique. Ensuite, maintiens le bouton d\'alimentation, balaie vers le haut depuis un coin du bas ou maintiens Home : Tetra écoute tout de suite et répond quand tu arrêtes de parler. Si ton téléphone réserve le bouton d\'alimentation à Google, active AI Assist dans Apparence › Icônes des applis et utilise son icône.</string>
    <string name="assistant_open">Ouvrir l\'assistant</string>
    <string name="assistant_offline">Pas de connexion internet.</string>
    <string name="assistant_bad_key">La clé Mistral est incorrecte. Vérifie-la dans Paramètres › AI Assist.</string>
    <string name="assistant_busy">Mistral est occupé, ou la clé n\'a plus de crédit. Réessaie dans une minute.</string>
    <string name="assistant_server">Mistral a répondu par une erreur (%1$d).</string>
    <string name="assistant_no_key">Ajoute d\'abord ta clé API Mistral : Paramètres › AI Assist.</string>
    <string name="assistant_words">Mes mots</string>
    <string name="assistant_words_note">Les noms et les mots que la transcription doit écrire correctement, séparés par des virgules. Ils sont envoyés à Mistral avec chaque enregistrement.</string>
    <string name="assistant_contact_words">Ajouter les noms de mes contacts favoris</string>
    <string name="assistant_contact_words_note">Jusqu\'à 50 favoris, pour que \"appelle …\" reconnaisse bien le nom. Ces noms sont ensuite envoyés à Mistral avec chaque enregistrement.</string>
