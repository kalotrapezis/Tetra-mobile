    <string name="assistant_key">Klucz API Mistral</string>
    <string name="assistant_key_hint">Wklej klucz</string>
    <string name="assistant_key_saved">Zapisany na tym telefonie</string>
    <string name="assistant_key_missing">Jeszcze nie ustawiono</string>
    <string name="assistant_key_note">Utwórz go na console.mistral.ai › API Keys. Jest przechowywany w postaci zaszyfrowanej na tym telefonie. To, co mówisz, twoje pytania i krótkie odpowiedzi narzędzi (nazwy, tytuły) trafiają do Mistral; twoje pliki zostają tutaj.</string>
    <string name="assistant_default">Domyślny asystent</string>
    <string name="assistant_default_yes">Tetra</string>
    <string name="assistant_default_no">Inna aplikacja</string>
    <string name="assistant_choose">Wybierz</string>
    <string name="assistant_default_note">Wybierz Tetra jako aplikację asystenta cyfrowego. Potem przytrzymaj przycisk zasilania, przesuń palcem w górę z dolnego rogu albo przytrzymaj Home: Tetra od razu słucha i odpowiada, gdy przestaniesz mówić. Jeśli telefon rezerwuje przycisk zasilania dla Google, włącz AI Assist w Wygląd › Ikony aplikacji i użyj jego ikony.</string>
    <string name="assistant_open">Otwórz asystenta</string>
    <string name="assistant_offline">Brak połączenia z internetem.</string>
    <string name="assistant_bad_key">Klucz Mistral jest nieprawidłowy. Sprawdź go w Ustawienia › AI Assist.</string>
    <string name="assistant_busy">Mistral jest zajęty albo na kluczu skończyły się środki. Spróbuj ponownie za minutę.</string>
    <string name="assistant_server">Mistral odpowiedział błędem (%1$d).</string>
    <string name="assistant_no_key">Najpierw dodaj swój klucz API Mistral: Ustawienia › AI Assist.</string>
    <string name="assistant_words">Moje słowa</string>
    <string name="assistant_words_note">Imiona i słowa, które transkrypcja ma zapisywać poprawnie, oddzielone przecinkami. Są wysyłane do Mistral z każdym nagraniem.</string>
    <string name="assistant_contact_words">Dodaj nazwy moich ulubionych kontaktów</string>
    <string name="assistant_contact_words_note">Do 50 ulubionych, aby \"zadzwoń do …\" poprawnie rozpoznało nazwę. Te nazwy są potem wysyłane do Mistral z każdym nagraniem.</string>
    <string name="assistant_live">Na żywo</string>
    <string name="assistant_live_end">Zakończ rozmowę na żywo</string>
    <string name="assistant_live_connecting">Łączenie…</string>
    <string name="assistant_live_silence">Rozmowa na żywo zakończyła się po 20 sekundach ciszy.</string>
    <string name="assistant_live_cap">Rozmowa na żywo zakończyła się po 5 minutach.</string>
    <string name="assistant_you">Ty</string>
    <string name="assistant_voice">Głos</string>
    <string name="assistant_voice_note">Głosy Mistral brzmią naturalnie i kosztują niewiele (€0.016 za 1000 przeczytanych znaków). Mistral nie ma polskiego głosu, ale angielskie dobrze czytają też inne języki. Dotknij głosu, aby go usłyszeć.</string>
    <string name="assistant_voice_phone">Głos telefonu (bezpłatny)</string>
    <string name="assistant_voice_first">Pierwszy głos Mistral</string>
    <string name="assistant_voice_sample">Cześć, tak będą brzmieć moje odpowiedzi.</string>
    <string name="assistant_spent">Wydane pieniądze</string>
    <string name="assistant_spent_note">Wszystkie koszty AI Assist w cenach Mistral, wszystkie rozmowy razem. Wyzerowanie zaczyna nowe liczenie; suma i poprzednie liczenia zostają.</string>
